# Copy this file to backend/.env and add at least one key. Never commit backend/.env.
# Pools first: Groq -> Gemini -> optional single-key providers/Ollama -> Pollinations -> template.
# Comma-separated server-only pools. Multiple keys do not create extra account quota.
GROQ_API_KEYS=
GEMINI_API_KEYS=
POLLINATIONS_API_KEY=
POLLINATIONS_MODEL=openai
# Optional Groq male voice (Troy); requires accepting Orpheus model terms.
ASTRO_TTS_ENABLED=1
# Natural female/male Hindi and Indian-English guide speech (Edge, Gemini fallback).
ASTRO_GUIDE_NEURAL_VOICE=1
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Optional local provider. Leave ASTRO_AI_MODELS empty when Ollama is not installed.
ASTRO_AI_URL=http://127.0.0.1:11434/api/generate
ASTRO_AI_MODELS=
ASTRO_AI_TIMEOUT_SECONDS=8
